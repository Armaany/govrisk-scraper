# Devex credentials
DEVEX_EMAIL=
DEVEX_PASSWORD=
DEVEX_SESSION_PATH=./devex_session.json
DEVEX_ENABLED=true

# UNDP Procurement Notices portal — always enabled by default, no API key required
UNDP_ENABLED=true

# LLM
ANTHROPIC_API_KEY=

# Data store — set STORE_TYPE to sheets or airtable
STORE_TYPE=sheets

# Google Sheets — required if STORE_TYPE=sheets
GOOGLE_SHEETS_ID=
SHEETS_TAB_NAME=Opportunities
SERVICE_ACCOUNT_JSON=./service_account.json

# Airtable — required if STORE_TYPE=airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Opportunities

# Keyword filters
SECTOR_KEYWORDS=AML,anti-corruption,illicit flows,human trafficking,justice reform,corruption,illicit finance,beneficial ownership,asset recovery,money laundering
TARGET_COUNTRIES=Mexico,Colombia,Peru,Brazil,Ecuador,Bolivia,Guatemala,Honduras,El Salvador,Nicaragua,Costa Rica,Panama,Dominican Republic,Haiti,Jamaica,Trinidad,Guyana,Venezuela,Cuba,LATAM,Latin America,Caribbean,Regional

# Run settings
MAX_RESULTS=50
RUN_MODE=dry_run
HEADLESS=false
LOG_LEVEL=INFO

# Notifications
NOTIFICATION_EMAIL=
ADMIN_ALERT_EMAIL=
GMAIL_APP_PASSWORD=

# SAM.gov portal — set SAM_GOV_ENABLED=true and provide an API key to activate
SAM_GOV_API_KEY=
SAM_GOV_ENABLED=false

# Perplexity portal — set PERPLEXITY_ENABLED=true and provide an API key to activate
PERPLEXITY_API_KEY=
PERPLEXITY_ENABLED=false

# US Grants (grants.gov — replaces USAID, no key required)
USAID_ENABLED=true

# World Bank procurement notices (no key required)
WORLDBANK_ENABLED=true
